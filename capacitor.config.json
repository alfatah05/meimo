{
  "appId": "com.meimo.app",
  "appName": "Meimo",
  "webDir": "www",
  "backgroundColor": "#1E1E1E",
  "android": {
    "backgroundColor": "#1E1E1E",
    "allowMixedContent": false,
    "adjustMarginsForEdgeToEdge": "disable"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#1E1E1E",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#1E1E1E",
      "overlaysWebView": true
    },
    "Keyboard": {
      "resize": "body",
      "style": "DARK"
    },
    "NavigationBar": {
      "color": "#1E1E1E",
      "style": "DARK"
    }
  }
}
